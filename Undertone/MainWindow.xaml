<Window x:Class="Undertone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Undertone.UI"
        Title="Undertone" Icon="/Assets/undertone.ico" Width="1220" Height="800" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <!-- Артисты через запятую, каждый кликабельный -->
        <DataTemplate x:Key="ArtistLinkTemplate" DataType="{x:Type ui:ArtistLink}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Style="{StaticResource LinkText}" MouseLeftButtonUp="ArtistLink_Click"/>
                <TextBlock Text="{Binding Separator}"/>
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- Строка трека -->
        <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type ui:TrackItem}">
            <Grid x:Name="Root" Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Num" Text="{Binding Index}" Foreground="{StaticResource TextFaintBrush}"
                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="PlayingGlyph" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{DynamicResource LiveAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <Grid Grid.Column="1" Width="44" Height="44" HorizontalAlignment="Left">
                    <Border CornerRadius="8" Background="{StaticResource CardBrush}">
                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#40FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover, Converter={StaticResource CoverConverter}, ConverterParameter=88}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,16,0">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis"/>
                    <ItemsControl ItemsSource="{Binding ArtistLinks}" ItemTemplate="{StaticResource ArtistLinkTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}" ClipToBounds="True" Focusable="False"
                                  Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding Album}" Foreground="{StaticResource TextDimBrush}" FontSize="13"
                           Style="{StaticResource LinkText}" MouseLeftButtonUp="AlbumLink_Click" HorizontalAlignment="Left"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="4" Text="{Binding Duration}" Foreground="{StaticResource TextFaintBrush}" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>

                <Button x:Name="Heart" Grid.Column="5" Click="RowLike_Click" Width="32" Height="32" FontSize="14"
                        ToolTip="Мне нравится">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Content" Value="&#xEB51;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Content" Value="&#xEB52;"/>
                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="PlayingGlyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource LiveAccent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TrackRow" TargetType="ListBoxItem" BasedOn="{StaticResource TrackRowContainer}">
            <EventSetter Event="MouseLeftButtonUp" Handler="Row_MouseUp"/>
            <EventSetter Event="MouseRightButtonUp" Handler="Row_RightClick"/>
        </Style>

        <!-- Строка очереди справа: узкая, без альбома -->
        <DataTemplate x:Key="QueueRowTemplate" DataType="{x:Type ui:TrackItem}">
            <Grid x:Name="Root" Height="54">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Grid Width="42" Height="42" Margin="6,0,12,0">
                    <Border CornerRadius="7" Background="{StaticResource CardBrush}">
                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#40FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="7">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover, Converter={StaticResource CoverConverter}, ConverterParameter=84}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                        <Run Text="{Binding Artists, Mode=OneWay}"/><Run Text="{Binding AddedText, Mode=OneWay}"
                                                                         Foreground="{DynamicResource LiveAccent}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="Dur" Grid.Column="2" Text="{Binding Duration}" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="Heart" Grid.Column="2" Click="RowLike_Click" Width="32" Height="32" FontSize="13"
                        HorizontalAlignment="Right" Margin="0,0,2,0" ToolTip="Мне нравится" Visibility="Hidden">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="&#xEB51;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                    <Setter Property="Content" Value="&#xEB52;"/>
                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Dur" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="Heart" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource LiveAccent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Карточка трека на полке: обложка, при наведении — круглая кнопка цвета обложки -->
        <DataTemplate x:Key="TrackTileTemplate" DataType="{x:Type ui:TrackItem}">
            <StackPanel x:Name="Root" Width="152" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform/>
                </StackPanel.RenderTransform>
                <Grid Width="152" Height="152">
                    <Border CornerRadius="12" Background="{StaticResource CardBrush}">
                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="#30FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="12">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CoverLarge, Converter={StaticResource CoverConverter}, ConverterParameter=304}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="12" BorderBrush="#14FFFFFF" BorderThickness="1"/>
                    <Border x:Name="Shade" CornerRadius="12" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.35"/>
                                <GradientStop Color="#A0000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="PlayDot" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource LiveAccent}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Opacity="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
                        </Border.Effect>
                        <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource LiveInk}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="2,0,0,0"/>
                    </Border>
                </Grid>
                <Grid Margin="2,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artists}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="Heart" Grid.Column="1" Click="RowLike_Click" Width="28" Height="28" FontSize="12.5"
                            VerticalAlignment="Top" Margin="4,0,0,0" ToolTip="Мне нравится">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xEB51;"/>
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Content" Value="&#xEB52;"/>
                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetName="PlayDot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="PlayDot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource LiveAccent}"/>
                    <Setter TargetName="PlayGlyph" Property="Text" Value="&#xE995;"/>
                    <Setter TargetName="PlayGlyph" Property="Margin" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ShelfItem" TargetType="ListBoxItem" BasedOn="{StaticResource ShelfItemContainer}">
            <EventSetter Event="MouseLeftButtonUp" Handler="Row_MouseUp"/>
            <EventSetter Event="MouseRightButtonUp" Handler="Row_RightClick"/>
        </Style>

        <Style x:Key="PlaylistRow" TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItem}">
            <EventSetter Event="MouseRightButtonUp" Handler="PlaylistNav_RightClick"/>
        </Style>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo Description="Предыдущий" ImageSource="{StaticResource ThumbPrevImage}" Click="Thumb_Prev"/>
                <ThumbButtonInfo Description="Играть" ImageSource="{StaticResource ThumbPlayImage}" Click="Thumb_Play"/>
                <ThumbButtonInfo Description="Следующий" ImageSource="{StaticResource ThumbNextImage}" Click="Thumb_Next"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ Сайдбар ═══════════ -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,22,14,14" LastChildFill="True">

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,24">
                        <Image Source="/Assets/logo-mark.png" Width="42" Height="36" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Undertone" FontSize="19" FontWeight="Bold"/>
                            <TextBlock x:Name="AppVersionText" Text="Яндекс Музыка · SoundCloud" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="WaveCard" DockPanel.Dock="Top" Style="{StaticResource WaveCardButton}"
                            Click="Wave_Click" Margin="0,0,0,20" ToolTip="Моя волна (W)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Моя волна" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="WaveCardSub" Text="Музыка под ваш вкус" FontSize="12" Opacity="0.8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="1" Width="38" Height="38">
                                <Ellipse Fill="#33FFFFFF"/>
                                <TextBlock x:Name="WaveCardGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Button>

                    <!-- быстрый поиск -->
                    <Button DockPanel.Dock="Top" Margin="0,-8,0,14" Click="QuickOpen_Click" Cursor="Hand" Focusable="False"
                            ToolTip="Быстрый поиск (Ctrl+K)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Height="38" CornerRadius="10" Background="#0AFFFFFF" BorderBrush="#14FFFFFF"
                                        BorderThickness="1" Padding="12,0,8,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Поиск" FontSize="13" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#14FFFFFF"
                                                CornerRadius="5" Padding="6,2">
                                            <TextBlock Text="Ctrl K" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavNow" Style="{StaticResource NavButton}" Tag="&#xE8D6;" Content="Сейчас играет"
                                     IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLiked" Style="{StaticResource NavButton}" Tag="&#xEB51;" Content="Мне нравится"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSearch" Style="{StaticResource NavButton}" Tag="&#xE721;" Content="Поиск"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSmart" Style="{StaticResource NavButton}" Tag="&#xE71C;" Content="Подборки"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLocal" Style="{StaticResource NavButton}" Tag="&#xE8B7;" Content="Мои файлы"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="История"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavFriends" Style="{StaticResource NavButton}" Tag="&#xE716;" Content="Друзья"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Настройки"
                                     Checked="Nav_Checked"/>
                    </StackPanel>

                    <!-- заголовок «Плейлисты» -->
                    <Grid DockPanel.Dock="Top" Margin="12,18,0,6">
                        <TextBlock Text="ПЛЕЙЛИСТЫ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" Width="28" Height="28" FontSize="12"
                                HorizontalAlignment="Right" ToolTip="Новый плейлист" Click="NewPlaylist_Click"/>
                    </Grid>

                    <!-- аккаунт: клик — меню аккаунтов (переключение Яндекс Музыка / SoundCloud) -->
                    <Border x:Name="AccountCard" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Background="{StaticResource CardBrush}"
                            CornerRadius="12" Padding="10" Margin="0,10,0,0" Cursor="Hand"
                            MouseLeftButtonUp="AccountCard_MouseUp" ToolTip="Аккаунты: переключиться, подключить, выйти">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="38" Height="38">
                                <Ellipse Fill="{DynamicResource LiveAccent}"/>
                                <TextBlock x:Name="AvatarLetter" Text="?" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource LiveInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Stroke="#33FFFFFF" StrokeThickness="1"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AccountName" Text="Подключение…" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AccountSub" Text="" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="RetryBtn" Style="{StaticResource IconButton}" Content="&#xE72C;" Width="30" Height="30"
                                        FontSize="13" ToolTip="Переподключиться" Click="Retry_Click" Visibility="Collapsed"/>
                                <Button x:Name="AccountMoreBtn" Style="{StaticResource IconButton}" Content="&#xE712;" Width="30" Height="30"
                                        FontSize="13" ToolTip="Аккаунты: Яндекс Музыка и SoundCloud" Click="AccountMore_Click"/>
                                <Button x:Name="LogoutBtn" Style="{StaticResource IconButton}" Content="&#xE7E8;" Width="30" Height="30"
                                        FontSize="13" ToolTip="Выйти из аккаунта" Click="Logout_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- обновление -->
                    <Border x:Name="UpdateBanner" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,10,0,0"
                            CornerRadius="12" Padding="12,10" Visibility="Collapsed"
                            Background="#14FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="White" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="UpdateTitle" Text="Доступно обновление" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="UpdateSub" Text="" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <Button x:Name="UpdateBtn" Style="{StaticResource PillButton}" Content="Обновить"
                                        Padding="14,6" FontSize="12.5" HorizontalAlignment="Left" Click="Update_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- список плейлистов — занимает оставшееся место и прокручивается -->
                    <Grid>
                        <ListBox x:Name="PlaylistNav" Style="{StaticResource TrackList}" ItemContainerStyle="{StaticResource PlaylistRow}"
                                 SelectionChanged="PlaylistNav_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:PlaylistItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="34" Height="34">
                                            <Border CornerRadius="7" Background="{StaticResource CardBrush}">
                                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           Foreground="#50FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="7">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Cover, Converter={StaticResource CoverConverter}, ConverterParameter=68}"
                                                                Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource TextFaintBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="PlaylistsEmpty" Text="Нажмите +, чтобы создать первый плейлист"
                                   FontSize="12" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap"
                                   Margin="12,4,12,0" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ═══════════ Контент ═══════════ -->
            <Grid Grid.Column="1">

                <!-- фон страниц артиста/альбома/плейлиста: размытая обложка полосой сверху -->
                <Grid x:Name="CollBackdrop" ClipToBounds="True" IsHitTestVisible="False" VerticalAlignment="Top" Height="440"
                      Visibility="{Binding Visibility, ElementName=PageCollection}">
                    <Image x:Name="CollBackdropImage" Stretch="UniformToFill" Opacity="0.55" Margin="-120,-160,-120,-40">
                        <Image.Effect>
                            <BlurEffect Radius="100" KernelType="Gaussian" RenderingBias="Performance"/>
                        </Image.Effect>
                    </Image>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#330D0E12" Offset="0"/>
                                <GradientStop Color="#C00D0E12" Offset="0.6"/>
                                <GradientStop Color="#FF0D0E12" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <!-- «Мне нравится»: тёплый отсвет сверху -->
                <Rectangle IsHitTestVisible="False" VerticalAlignment="Top" Height="380"
                           Visibility="{Binding Visibility, ElementName=PageLiked}">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#40C2365A" Offset="0"/>
                            <GradientStop Color="#14F0566A" Offset="0.55"/>
                            <GradientStop Color="#00F0566A" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ── Сейчас играет ── -->
                <Grid x:Name="PageNow" SizeChanged="PageNow_SizeChanged">
                    <!-- фон: размытая обложка, гаснет к низу -->
                    <Grid ClipToBounds="True" IsHitTestVisible="False">
                        <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity="0.5" Margin="-120">
                            <Image.Effect>
                                <BlurEffect Radius="110" KernelType="Gaussian" RenderingBias="Performance"/>
                            </Image.Effect>
                        </Image>
                        <!-- живой фон: пятна цветов обложки плывут и дышат (Настройки → Приложение) -->
                        <ui:LiveBackdrop x:Name="LiveBg" Opacity="0.75" Visibility="Collapsed"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#400D0E12" Offset="0"/>
                                    <GradientStop Color="#D90D0E12" Offset="0.55"/>
                                    <GradientStop Color="#FF0D0E12" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <!-- пустое состояние: большая кнопка «Моя волна» -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="260" Height="260">
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.45" To="1" Duration="0:0:3"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.45" To="1" Duration="0:0:3"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:3"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.45" To="1" Duration="0:0:3" BeginTime="0:0:1"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.45" To="1" Duration="0:0:3" BeginTime="0:0:1"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:3" BeginTime="0:0:1"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.45" To="1" Duration="0:0:3" BeginTime="0:0:2"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.45" To="1" Duration="0:0:3" BeginTime="0:0:2"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring3" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:3" BeginTime="0:0:2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Ellipse x:Name="Ring1" Stroke="#B0FFFFFF" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring2" Stroke="#9A7BF5" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring3" Stroke="{DynamicResource LiveAccent}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="128" Height="128" Fill="{StaticResource WaveGradient}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#5B8EF0" BlurRadius="50" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Button x:Name="EmptyPlay" Style="{StaticResource PlayButton}" Width="128" Height="128" Background="Transparent"
                                    Foreground="White" FontSize="40" Content="&#xE768;" Click="Wave_Click" ToolTip="Запустить Мою волну"/>
                        </Grid>
                        <TextBlock x:Name="EmptyTitle" Text="Моя волна" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock x:Name="EmptySub" Text="Бесконечный поток музыки под ваш вкус" FontSize="15"
                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Или выберите трек в «Мне нравится», поиске или своих плейлистах" FontSize="13"
                                   Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- текущий трек: слева — трек и полки, справа — очередь -->
                    <Grid x:Name="NowState" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="QueueColumn" Width="320"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="40,36,32,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- ── трек ── -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="HeroCover" Width="300" Height="300" VerticalAlignment="Top">
                                    <!-- свечение цвета обложки под ней -->
                                    <Border CornerRadius="16" Background="#01000000" Margin="18,26,18,0">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="HeroGlow" Color="#BFC3D0" BlurRadius="90" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border CornerRadius="16" Background="{StaticResource CardBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.5" Color="Black"/>
                                        </Border.Effect>
                                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="72" Foreground="#30FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="16">
                                        <Border.Background>
                                            <ImageBrush x:Name="BigCoverBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="16" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                                    <!-- реакции комнаты всплывают над обложкой -->
                                    <Canvas x:Name="ReactionLayer" IsHitTestVisible="False" ClipToBounds="False"/>
                                </Grid>

                                <DockPanel Grid.Column="1" Margin="36,0,0,0" LastChildFill="False" MaxWidth="680" HorizontalAlignment="Left">
                                    <StackPanel DockPanel.Dock="Top">
                                        <!-- откуда играет: волна, плейлист, «слушаем вместе» -->
                                        <Border x:Name="NowSourceChip" Background="{DynamicResource LiveAccentSoft}" CornerRadius="100"
                                                Padding="11,4,12,5" HorizontalAlignment="Left">
                                            <TextBlock x:Name="NowSource" Text="СЕЙЧАС ИГРАЕТ" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource LiveAccent}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <TextBlock x:Name="NowTitle" FontSize="42" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="108" Margin="0,14,0,0" LineHeight="52"
                                                   LineStackingStrategy="BlockLineHeight" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                        <ItemsControl x:Name="NowArtists" ItemTemplate="{StaticResource ArtistLinkTemplate}"
                                                      ItemsPanel="{StaticResource HorizontalPanel}" ClipToBounds="True" Focusable="False"
                                                      FontSize="18" Foreground="{StaticResource TextBrush}" Opacity="0.82" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="NowAlbum" FontSize="13.5" Foreground="{StaticResource TextDimBrush}"
                                                   Style="{StaticResource LinkText}" MouseLeftButtonUp="NowAlbum_Click" HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="-6,16,0,0">
                                            <Button x:Name="NowLike" Style="{StaticResource IconButton}" Width="40" Height="40"
                                                    Click="Like_Click" ToolTip="Мне нравится (L)">
                                                <TextBlock x:Name="NowLikeGlyph" Text="&#xEB51;" FontFamily="{StaticResource IconFont}" FontSize="17"/>
                                            </Button>
                                            <Button x:Name="NowDislike" Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="16"
                                                    Content="&#xE8E0;" Click="Dislike_Click" ToolTip="Не рекомендовать и пропустить (D)"/>
                                            <Button x:Name="NowLyricsBtn" Style="{StaticResource IconButton}" Width="40" Height="40"
                                                    Click="NowLyrics_Click" ToolTip="Текст песни (T)">
                                                <TextBlock x:Name="NowLyricsGlyph" Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                                            </Button>
                                            <Button x:Name="NowMore" Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="16"
                                                    Content="&#xE712;" ToolTip="Ещё: в плейлист, к артисту, к альбому" Click="NowMore_Click"/>
                                            <!-- реакции — только в комнате «Слушать вместе» -->
                                            <StackPanel x:Name="ReactionBar" Orientation="Horizontal" Visibility="Collapsed" Margin="10,0,0,0">
                                                <Border Width="1" Height="20" Background="#24FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource ReactionButton}" Tag="fire" Click="Reaction_Click" ToolTip="Огонь">
                                                    <Image Source="/Assets/Reactions/fire.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                                <Button Style="{StaticResource ReactionButton}" Tag="heart" Click="Reaction_Click" ToolTip="Люблю">
                                                    <Image Source="/Assets/Reactions/heart.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                                <Button Style="{StaticResource ReactionButton}" Tag="laugh" Click="Reaction_Click" ToolTip="Смешно">
                                                    <Image Source="/Assets/Reactions/laugh.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                                <Button Style="{StaticResource ReactionButton}" Tag="mind" Click="Reaction_Click" ToolTip="Взрыв мозга">
                                                    <Image Source="/Assets/Reactions/mind.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                                <Button Style="{StaticResource ReactionButton}" Tag="clap" Click="Reaction_Click" ToolTip="Браво">
                                                    <Image Source="/Assets/Reactions/clap.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                                <Button Style="{StaticResource ReactionButton}" Tag="skull" Click="Reaction_Click" ToolTip="Умер">
                                                    <Image Source="/Assets/Reactions/skull.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- плеер прямо под треком -->
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                                        <Slider x:Name="HeroSlider" Style="{StaticResource HeroSlider}" Minimum="0" Maximum="1" Value="0"
                                                ValueChanged="Progress_ValueChanged"/>
                                        <Grid Margin="0,2,0,0">
                                            <TextBlock x:Name="HeroPos" Text="0:00" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock x:Name="HeroRemain" Text="0:00" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="HeroShuffle" Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="16"
                                                    Click="Shuffle_Click" ToolTip="Перемешать (S)" HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="19" Width="46" Height="46"
                                                        Foreground="{StaticResource TextBrush}" Click="Prev_Click" ToolTip="Предыдущий (P)" Margin="0,0,14,0"/>
                                                <Button x:Name="HeroPlayBtn" Style="{StaticResource HeroPlay}" Content="&#xE768;"
                                                        Click="Play_Click" ToolTip="Играть / пауза (Пробел)"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="19" Width="46" Height="46"
                                                        Foreground="{StaticResource TextBrush}" Click="Next_Click" ToolTip="Следующий (N)" Margin="14,0,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="HeroRepeat" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8EE;" FontSize="16"
                                                    Click="Repeat_Click" ToolTip="Повтор (R)" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>

                            <!-- визуализатор — граница между «сейчас» и «дальше»; клик меняет вид -->
                            <ui:Visualizer x:Name="BigViz" Grid.Row="1" Height="34" Margin="0,26,0,0" BarCount="72" Opacity="0.36"/>

                            <!-- ── полки / текст песни ── -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <ScrollViewer x:Name="ShelvesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <StackPanel Margin="0,8,0,24">
                                        <DockPanel x:Name="SimilarShelf" Visibility="Collapsed" Margin="0,0,0,26">
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                                <TextBlock Text="Похожие треки" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="32" Height="32" FontSize="12"
                                                            Tag="{Binding ElementName=SimilarList}" Click="ShelfPrev_Click" ToolTip="Назад"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="32" Height="32" FontSize="12"
                                                            Tag="{Binding ElementName=SimilarList}" Click="ShelfNext_Click" ToolTip="Дальше"/>
                                                </StackPanel>
                                            </Grid>
                                            <ListBox x:Name="SimilarList" Style="{StaticResource ShelfList}" ItemContainerStyle="{StaticResource ShelfItem}"
                                                     ItemTemplate="{StaticResource TrackTileTemplate}" PreviewMouseWheel="Shelf_PreviewMouseWheel"/>
                                        </DockPanel>
                                        <DockPanel x:Name="RecentShelf" Visibility="Collapsed">
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                                <TextBlock Text="Недавно слушали" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="32" Height="32" FontSize="12"
                                                            Tag="{Binding ElementName=RecentList}" Click="ShelfPrev_Click" ToolTip="Назад"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="32" Height="32" FontSize="12"
                                                            Tag="{Binding ElementName=RecentList}" Click="ShelfNext_Click" ToolTip="Дальше"/>
                                                </StackPanel>
                                            </Grid>
                                            <ListBox x:Name="RecentList" Style="{StaticResource ShelfList}" ItemContainerStyle="{StaticResource ShelfItem}"
                                                     ItemTemplate="{StaticResource TrackTileTemplate}" PreviewMouseWheel="Shelf_PreviewMouseWheel"/>
                                        </DockPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- текст песни встаёт на место полок -->
                                <Grid x:Name="LyricsPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                    <ListBox x:Name="LyricsList" Style="{StaticResource TrackList}"
                                             ScrollViewer.CanContentScroll="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <EventSetter Event="MouseLeftButtonUp" Handler="LyricLine_Click"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,7">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ui:LyricLine}">
                                                <StackPanel>
                                                    <TextBlock x:Name="Line" Text="{Binding Text}" FontSize="24" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" Foreground="#4C4F5A"
                                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                                    <!-- перевод строки — мельче и спокойнее, под оригиналом -->
                                                    <TextBlock x:Name="Tr" Text="{Binding Translation}" FontSize="15" TextWrapping="Wrap"
                                                               Foreground="#5E616C" Margin="0,3,0,0"
                                                               Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                        <Setter TargetName="Line" Property="Foreground" Value="#80838F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource LiveAccent}"/>
                                                        <Setter TargetName="Tr" Property="Foreground" Value="#B8BBC6"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPlain}" Value="True">
                                                        <Setter TargetName="Line" Property="Foreground" Value="#C8CAD2"/>
                                                        <Setter TargetName="Line" Property="FontSize" Value="17"/>
                                                        <Setter TargetName="Line" Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="LyricsStatus" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Control x:Name="LyricsSpinner" Style="{StaticResource Spinner}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="LyricsStatusText" Text="Загружаю текст…" Foreground="{StaticResource TextDimBrush}"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,12,0,0"/>
                                    </StackPanel>
                                    <!-- перевод: справа сверху над текстом -->
                                    <Button x:Name="TranslateBtn" Style="{StaticResource PillSecondary}" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="0,0,14,0" Padding="12,6" FontSize="12.5" Visibility="Collapsed"
                                            Click="Translate_Click" ToolTip="Перевести текст на русский">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TranslateGlyph" Text="&#xE8C1;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="TranslateText" Text="Перевод" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="LyricsCredits" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                               FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="10,0,0,6"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- ── очередь «Далее»: перетаскивание меняет порядок, правый клик — убрать ── -->
                        <Border Grid.Column="1" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1,0,0,0">
                            <DockPanel x:Name="UpNextPanel" Margin="14,30,8,0">
                                <Grid DockPanel.Dock="Top" Margin="8,0,6,12">
                                    <StackPanel>
                                        <TextBlock x:Name="UpNextHeader" Text="Далее" FontSize="19" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                        <TextBlock x:Name="UpNextSub" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="UpNextClear" Style="{StaticResource IconButton}" Content="&#xE894;" Width="34" Height="34"
                                            FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            ToolTip="Очистить: убрать всё, что после текущего трека" Click="UpNextClear_Click"/>
                                </Grid>
                                <ListBox x:Name="UpNextList" Style="{StaticResource TrackList}" AllowDrop="True"
                                         ItemContainerStyle="{StaticResource TrackRow}" ItemTemplate="{StaticResource QueueRowTemplate}"
                                         KeyDown="List_KeyDown"
                                         PreviewMouseLeftButtonDown="UpNext_PreviewMouseDown" PreviewMouseMove="UpNext_PreviewMouseMove"
                                         DragOver="UpNext_DragOver" Drop="UpNext_Drop"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ── Мне нравится ── -->
                <DockPanel x:Name="PageLiked" Visibility="Collapsed" Margin="32,30,16,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,16,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="150" Height="150" CornerRadius="18" Background="{StaticResource LikedGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="#F0566A" BlurRadius="44" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="58" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="ПЛЕЙЛИСТ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="Мне нравится" FontSize="42" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock x:Name="LikedCount" Text="" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CirclePlay}" Content="&#xE768;" Click="LikedPlay_Click"
                                        ToolTip="Слушать по порядку" Margin="0,0,14,0"/>
                                <Button Style="{StaticResource CircleGhost}" Content="&#xE8B1;" Click="LikedShuffle_Click"
                                        ToolTip="Перемешать" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="LikedDownload" Style="{StaticResource PillSecondary}" Click="LikedDownload_Click"
                                        VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LikedDownloadGlyph" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="LikedDownloadText" Text="Скачать" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <TextBox x:Name="LikedFilter" Grid.Column="2" Width="250" VerticalAlignment="Bottom"
                                 Style="{StaticResource SearchBox}" Height="40" FontSize="13" Tag="Найти в любимых"
                                 TextChanged="LikedFilter_TextChanged"/>
                    </Grid>
                    <Grid>
                        <ListBox x:Name="LikedList" Style="{StaticResource TrackList}"
                                 ItemContainerStyle="{StaticResource TrackRow}" ItemTemplate="{StaticResource TrackRowTemplate}"
                                 KeyDown="List_KeyDown"/>
                        <StackPanel x:Name="LikedLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Control Style="{StaticResource Spinner}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Загружаю любимые треки…" Foreground="{StaticResource TextDimBrush}" Margin="0,12,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LikedEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                    </Grid>
                </DockPanel>

                <!-- ── Поиск ── -->
                <DockPanel x:Name="PageSearch" Visibility="Collapsed" Margin="32,30,16,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,16,22" MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="52" FontSize="16"
                                 Tag="Трек, исполнитель, альбом…" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
                        <Button x:Name="SearchClear" Style="{StaticResource IconButton}" Content="&#xE711;" Width="30" Height="30"
                                FontSize="11" HorizontalAlignment="Right" Margin="0,0,10,0" Visibility="Collapsed"
                                ToolTip="Очистить" Click="SearchClear_Click"/>
                    </Grid>
                    <!-- лучший результат -->
                    <Border x:Name="SearchBest" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,16,16" MaxWidth="760"
                            HorizontalAlignment="Left" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14"
                            Cursor="Hand" MouseLeftButtonUp="SearchBest_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="72" Height="72">
                                <Border x:Name="SearchBestCoverBack" CornerRadius="10" Background="{StaticResource HoverBrush}"/>
                                <Border x:Name="SearchBestCover" CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush x:Name="SearchBestCoverBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="16,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SearchBestKind" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock x:Name="SearchBestTitle" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock x:Name="SearchBestSub" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- что показывать -->
                    <WrapPanel x:Name="SearchTabs" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,16,8">
                        <RadioButton x:Name="SearchTabTracks" Style="{StaticResource ChoicePill}" GroupName="SearchTab" Content="Треки"
                                     IsChecked="True" Checked="SearchTab_Checked"/>
                        <RadioButton x:Name="SearchTabArtists" Style="{StaticResource ChoicePill}" GroupName="SearchTab" Content="Артисты"
                                     Checked="SearchTab_Checked"/>
                        <RadioButton x:Name="SearchTabAlbums" Style="{StaticResource ChoicePill}" GroupName="SearchTab" Content="Альбомы"
                                     Checked="SearchTab_Checked"/>
                        <RadioButton x:Name="SearchTabPlaylists" Style="{StaticResource ChoicePill}" GroupName="SearchTab" Content="Плейлисты"
                                     Checked="SearchTab_Checked"/>
                    </WrapPanel>

                    <Grid>
                        <ListBox x:Name="SearchList" Style="{StaticResource TrackList}"
                                 ItemContainerStyle="{StaticResource TrackRow}" ItemTemplate="{StaticResource TrackRowTemplate}"
                                 KeyDown="List_KeyDown" ScrollViewer.ScrollChanged="SearchList_ScrollChanged"/>

                        <!-- артисты / альбомы / плейлисты — карточками -->
                        <ScrollViewer x:Name="SearchCardsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="SearchCards" Margin="0,4,0,20">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:SearchCard}">
                                        <Border Width="150" Margin="0,0,18,20" Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonUp="SearchCard_Click" ToolTip="{Binding Title}">
                                            <StackPanel>
                                                <Grid Width="150" Height="150">
                                                    <Border x:Name="Back" CornerRadius="12" Background="{StaticResource CardBrush}">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="40"
                                                                   Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border x:Name="Img" CornerRadius="12">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Cover, Converter={StaticResource CoverConverter}, ConverterParameter=300}"
                                                                        Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="CardTitle" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                           Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRound}" Value="True">
                                                <Setter TargetName="Back" Property="CornerRadius" Value="75"/>
                                                <Setter TargetName="Img" Property="CornerRadius" Value="75"/>
                                                <Setter TargetName="CardTitle" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="SearchLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Control Style="{StaticResource Spinner}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="SearchEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="48"
                                       Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SearchEmptyText" Text="Найдите что угодно в каталоге Яндекс Музыки"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="15" Margin="0,16,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- ── Артист / альбом / плейлист ── -->
                <DockPanel x:Name="PageCollection" Visibility="Collapsed" Margin="32,22,16,0">
                    <Button x:Name="CollBack" DockPanel.Dock="Top" Style="{StaticResource IconButton}" Content="&#xE72B;"
                            HorizontalAlignment="Left" Margin="-6,0,0,6" ToolTip="Назад" Click="CollBack_Click"/>

                    <Grid DockPanel.Dock="Top" Margin="0,0,16,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="160" Height="160">
                            <Border x:Name="CollCoverBack" CornerRadius="16" Background="{StaticResource CardBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5" Color="Black"/>
                                </Border.Effect>
                                <TextBlock x:Name="CollCoverGlyph" Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="48"
                                           Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="CollCover" CornerRadius="16">
                                <Border.Background>
                                    <ImageBrush x:Name="CollCoverBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock x:Name="CollKind" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock x:Name="CollTitle" Text="" FontSize="40" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <ItemsControl x:Name="CollArtists" ItemTemplate="{StaticResource ArtistLinkTemplate}"
                                          ItemsPanel="{StaticResource HorizontalPanel}" Focusable="False" ClipToBounds="True"
                                          FontSize="15" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="CollSub" Text="" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CollPlay" Style="{StaticResource CirclePlay}" Content="&#xE768;" Click="CollPlay_Click"
                                        ToolTip="Слушать" Margin="0,0,14,0"/>
                                <Button x:Name="CollShuffle" Style="{StaticResource CircleGhost}" Content="&#xE8B1;" Click="CollShuffle_Click"
                                        ToolTip="Перемешать" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="CollDownload" Style="{StaticResource PillSecondary}" Click="CollDownload_Click"
                                        VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CollDownloadGlyph" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="CollDownloadText" Text="Скачать" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CollWave" Style="{StaticResource PillSecondary}" Click="CollWave_Click"
                                        VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE93E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Волна по артисту" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CollMore" Style="{StaticResource CircleGhost}" Content="&#xE712;" Click="CollMore_Click"
                                        ToolTip="Переименовать / удалить" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- альбомы артиста -->
                    <StackPanel x:Name="CollAlbumsSection" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,16,8">
                        <TextBlock Text="Альбомы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="Albums_PreviewMouseWheel">
                            <ItemsControl x:Name="CollAlbums" ItemsPanel="{StaticResource HorizontalPanel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:AlbumItem}">
                                        <Border Width="124" Margin="0,0,14,0" Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonUp="AlbumCard_Click" ToolTip="{Binding Title}">
                                            <StackPanel>
                                                <Grid Width="124" Height="124">
                                                    <Border CornerRadius="10" Background="{StaticResource CardBrush}"/>
                                                    <Border CornerRadius="10">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Cover, Converter={StaticResource CoverConverter}, ConverterParameter=248}"
                                                                        Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <TextBlock x:Name="CollTracksHeader" DockPanel.Dock="Top" Text="Треки" FontSize="16" FontWeight="SemiBold"
                               Margin="0,10,0,8"/>
                    <Grid>
                        <ListBox x:Name="CollList" Style="{StaticResource TrackList}"
                                 ItemContainerStyle="{StaticResource TrackRow}" ItemTemplate="{StaticResource TrackRowTemplate}"
                                 KeyDown="List_KeyDown"/>
                        <StackPanel x:Name="CollLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Control Style="{StaticResource Spinner}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="CollEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                    </Grid>
                </DockPanel>

                <!-- ── История ── -->
                <DockPanel x:Name="PageHistory" Visibility="Collapsed" Margin="32,30,16,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,16,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="150" Height="150" CornerRadius="18" Background="{StaticResource WaveGradient}">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="58" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="НА ЭТОМ КОМПЬЮТЕРЕ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="История" FontSize="42" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock x:Name="HistorySub" Text="" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="HistoryPlay" Style="{StaticResource CirclePlay}" Content="&#xE768;" Click="HistoryPlay_Click"
                                        ToolTip="Слушать заново" Margin="0,0,14,0"/>
                                <Button x:Name="HistoryClear" Style="{StaticResource PillSecondary}" Content="Очистить историю"
                                        VerticalAlignment="Center" Click="HistoryClear_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <ListBox x:Name="HistoryList" Style="{StaticResource TrackList}"
                                 ItemContainerStyle="{StaticResource TrackRow}" ItemTemplate="{StaticResource TrackRowTemplate}"
                                 KeyDown="List_KeyDown"/>
                        <TextBlock x:Name="HistoryEmpty" Text="Здесь появятся треки, которые вы слушали в Undertone."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                    </Grid>
                </DockPanel>

                <!-- ── Подборки (умные плейлисты) ── -->
                <DockPanel x:Name="PageSmart" Visibility="Collapsed" Margin="32,30,16,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,16,22">
                        <TextBlock Text="СОБИРАЮТСЯ САМИ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="Подборки" FontSize="42" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock Text="Плейлисты по правилам: что давно не играло, что на повторе, что слушаешь ночью. Обновляются при каждом открытии."
                                   FontSize="13" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" MaxWidth="620" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,0,16,24">
                            <ItemsControl x:Name="SmartList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:SmartItem}">
                                        <Border Width="184" Margin="0,0,18,22" Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonUp="SmartCard_Click" MouseRightButtonUp="SmartCard_RightClick">
                                            <StackPanel>
                                                <Grid Width="184" Height="184">
                                                    <Border x:Name="Tile" CornerRadius="16" Background="{Binding Background}" RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="54"
                                                                       Foreground="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                                       Margin="14,0,14,12" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Margin="0,10,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                           TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="RenderTransform">
                                                    <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource PillSecondary}" HorizontalAlignment="Left" Click="SmartNew_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Новая подборка" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ── Мои файлы ── -->
                <DockPanel x:Name="PageLocal" Visibility="Collapsed" Margin="32,30,16,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,16,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="150" Height="150" CornerRadius="18" Background="{DynamicResource LiveAccent}">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="58" Foreground="{DynamicResource LiveInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="НА ЭТОМ КОМПЬЮТЕРЕ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="Мои файлы" FontSize="42" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock x:Name="LocalSub" Text="" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LocalPlay" Style="{StaticResource CirclePlay}" Content="&#xE768;" Click="LocalPlay_Click"
                                        ToolTip="Слушать по порядку" Margin="0,0,14,0"/>
                                <Button Style="{StaticResource CircleGhost}" Content="&#xE8B1;" Click="LocalShuffle_Click"
                                        ToolTip="Перемешать" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource PillSecondary}" Click="LocalAddFolder_Click" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Добавить папку" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LocalRescan" Style="{StaticResource CircleGhost}" Content="&#xE72C;" Click="LocalRescan_Click"
                                        ToolTip="Пересканировать папки" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="LocalFoldersBtn" Style="{StaticResource CircleGhost}" Content="&#xE712;" Click="LocalFolders_Click"
                                        ToolTip="Папки: убрать из списка" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBox x:Name="LocalFilter" Grid.Column="2" Width="250" VerticalAlignment="Bottom"
                                 Style="{StaticResource SearchBox}" Height="40" FontSize="13" Tag="Найти в своих файлах"
                                 TextChanged="LocalFilter_TextChanged"/>
                    </Grid>
                    <Grid>
                        <ListBox x:Name="LocalList" Style="{StaticResource TrackList}"
                                 ItemContainerStyle="{StaticResource TrackRow}" ItemTemplate="{StaticResource TrackRowTemplate}"
                                 KeyDown="List_KeyDown"/>
                        <StackPanel x:Name="LocalEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="48"
                                       Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LocalEmptyText" Foreground="{StaticResource TextDimBrush}" FontSize="15" Margin="0,16,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Text="Добавь папку с mp3, flac или m4a — треки появятся здесь, в быстром поиске и будут играть в одной очереди с Яндексом."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- ── Друзья ── -->
                <DockPanel x:Name="PageFriends" Visibility="Collapsed" Margin="32,30,16,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,16,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="150" Height="150" CornerRadius="18" Background="{DynamicResource LiveAccent}">
                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="58" Foreground="{DynamicResource LiveInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="ЛЕНТА" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="Друзья" FontSize="42" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock x:Name="FriendsStatus" Text="" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,14"/>
                            <Button x:Name="FriendsSetupBtn" Style="{StaticResource PillSecondary}" Content="Настроить"
                                    HorizontalAlignment="Left" Click="FriendsSetup_Click"/>
                        </StackPanel>
                    </Grid>
                    <!-- Слушать вместе -->
                    <Border x:Name="TogetherCard" DockPanel.Dock="Top" Background="{StaticResource CardBrush}" CornerRadius="14"
                            Padding="16,14" Margin="0,0,32,16" MaxWidth="760" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource LiveAccent}">
                                <TextBlock Text="&#xE902;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource LiveInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TogetherTitle" Text="Слушать вместе" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="TogetherText" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                                           Text="Включите одну музыку на всех: пауза, перемотка и выбор трека — у всех сразу."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="TogetherHostOnly" Style="{StaticResource ToggleSwitch}" Visibility="Collapsed"
                                          VerticalAlignment="Center" Margin="0,0,18,0" Checked="TogetherHostOnly_Changed"
                                          Unchecked="TogetherHostOnly_Changed"
                                          ToolTip="Пауза, перемотка и выбор трека — только у тебя; друзья предлагают треки">
                                    <TextBlock Text="Управляю только я" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"/>
                                </CheckBox>
                                <Button x:Name="TogetherBtn" Style="{StaticResource PillButton}" Content="Слушать вместе"
                                        VerticalAlignment="Center" Click="Together_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Микс компании -->
                    <Border x:Name="MixCard" DockPanel.Dock="Top" CornerRadius="14" Padding="16,14" Margin="0,0,32,16" MaxWidth="760"
                            HorizontalAlignment="Stretch" Visibility="Collapsed" Background="{StaticResource CardBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Border CornerRadius="10" Background="{StaticResource LikedGradient}"/>
                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Микс компании" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="MixText" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MixOpenBtn" Style="{StaticResource PillSecondary}" Content="Открыть" Margin="0,0,10,0"
                                        Click="MixOpen_Click"/>
                                <Button x:Name="MixPlayBtn" Style="{StaticResource HeroPlay}" Width="42" Height="42" FontSize="15"
                                        Content="&#xE768;" ToolTip="Слушать микс" Click="MixPlay_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="FriendsList" Margin="0,0,16,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:FriendItem}">
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" Margin="0,0,0,10" MaxWidth="760"
                                                HorizontalAlignment="Left">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="60" Height="60">
                                                    <Border CornerRadius="10" Background="{StaticResource HoverBrush}">
                                                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="#70FFFFFF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border CornerRadius="10">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Cover, Converter={StaticResource CoverConverter}, ConverterParameter=120}"
                                                                        Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource TextFaintBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Artists}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource CircleGhost}" Content="&#xE768;" ToolTip="Включить этот трек"
                                                            Click="FriendPlay_Click" IsEnabled="{Binding HasTrack}" Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Сыграть следующим"
                                                            Click="FriendQueue_Click" IsEnabled="{Binding HasTrack}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="FriendsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                    </Grid>
                </DockPanel>

                <!-- ── Настройки ── -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="SettingsRoot" Margin="32,30,32,30" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Настройки" FontSize="42" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   Margin="0,0,0,18"/>

                        <!-- кэш -->
                        <TextBlock Text="КЭШ МУЗЫКИ" Style="{StaticResource SettingsHeader}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="CacheUsageText" Text="Считаю…" FontSize="15" FontWeight="SemiBold"/>
                                        <StackPanel x:Name="OfflineUsageRow" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{DynamicResource LiveAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="OfflineUsageText" FontSize="13" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Удалить" Style="{StaticResource LinkText}" FontSize="13" Margin="12,0,0,0"
                                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                                       MouseLeftButtonUp="OfflineClear_Click"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Прослушанные треки хранятся на диске и повторно не скачиваются. Когда кэш заполнится, удаляются те, что играли давно всего."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                        <Button x:Name="CacheClearBtn" Style="{StaticResource PillSecondary}" Padding="16,8" FontSize="13"
                                                Margin="0,0,8,0" Click="CacheClear_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Очистить кэш" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PillSecondary}" Padding="12,8" FontSize="13"
                                                ToolTip="Открыть папку кэша" Click="CacheOpen_Click">
                                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- полоса заполненности -->
                                <Grid x:Name="CacheBar" Height="6" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CacheBarUsed" Width="0*"/>
                                        <ColumnDefinition x:Name="CacheBarFree" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="3" Background="#18FFFFFF"/>
                                    <Border CornerRadius="3" Background="{DynamicResource LiveAccent}"/>
                                </Grid>

                                <TextBlock Text="Максимальный размер" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                                           Margin="0,18,0,8"/>
                                <WrapPanel x:Name="CacheLimitPanel">
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="CacheLimit" Content="512 МБ" Tag="512" Checked="CacheLimit_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="CacheLimit" Content="1 ГБ" Tag="1024" Checked="CacheLimit_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="CacheLimit" Content="2 ГБ" Tag="2048" Checked="CacheLimit_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="CacheLimit" Content="5 ГБ" Tag="5120" Checked="CacheLimit_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="CacheLimit" Content="10 ГБ" Tag="10240" Checked="CacheLimit_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="CacheLimit" Content="20 ГБ" Tag="20480" Checked="CacheLimit_Checked"/>
                                </WrapPanel>

                                <TextBlock Text="Заранее скачивать следующие треки" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                                           Margin="0,10,0,8"/>
                                <WrapPanel x:Name="PrefetchPanel">
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Prefetch" Content="Не качать" Tag="0" Checked="Prefetch_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Prefetch" Content="1 трек" Tag="1" Checked="Prefetch_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Prefetch" Content="2 трека" Tag="2" Checked="Prefetch_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Prefetch" Content="3 трека" Tag="3" Checked="Prefetch_Checked"/>
                                </WrapPanel>

                                <TextBlock x:Name="CachePathText" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- воспроизведение -->
                        <TextBlock Text="ВОСПРОИЗВЕДЕНИЕ" Style="{StaticResource SettingsHeader}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel x:Name="PlaybackSettings">
                                <TextBlock Text="Качество звука"/>
                                <TextBlock x:Name="QualityHint" Style="{StaticResource SettingsHint}"
                                           Text="«Без потерь» — FLAC для подписчиков Плюса; трек скачивается целиком перед стартом."/>
                                <WrapPanel x:Name="QualityPanel" Margin="0,10,0,0">
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Quality" Content="Экономия" Tag="0" Checked="Quality_Checked"
                                                 ToolTip="Самый низкий битрейт MP3 — для медленного или мобильного интернета"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Quality" Content="Высокое" Tag="1" Checked="Quality_Checked"
                                                 ToolTip="MP3 до 320 кбит/с"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Quality" Content="Без потерь" Tag="2" Checked="Quality_Checked"
                                                 ToolTip="FLAC (нужен Яндекс Плюс)"/>
                                </WrapPanel>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,8,0,16"/>
                                <TextBlock Text="Устройство вывода"/>
                                <TextBlock Style="{StaticResource SettingsHint}"
                                           Text="«Как в системе» — звук переходит на новое устройство сам, когда вы подключаете наушники."/>
                                <WrapPanel x:Name="OutputDevicePanel" Margin="0,10,0,0"/>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,8,0,16"/>
                                <CheckBox x:Name="StreamToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="StreamToggle_Changed" Unchecked="StreamToggle_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Играть сразу, не дожидаясь загрузки"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Трек начинает звучать через пару секунд после клика и докачивается во время игры."/>
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16"/>
                                <CheckBox x:Name="ResumeToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="ResumeToggle_Changed" Unchecked="ResumeToggle_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Продолжать с того же места"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="После перезапуска Undertone покажет трек, на котором вы остановились, и очередь."/>
                                    </StackPanel>
                                </CheckBox>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16"/>
                                <TextBlock Text="Переход между треками"/>
                                <TextBlock Style="{StaticResource SettingsHint}"
                                           Text="«Без паузы» — следующий трек начинается в ту же секунду. Кроссфейд — плавно наплывает на конец текущего. Работает, когда следующий трек уже скачан."/>
                                <WrapPanel x:Name="CrossfadePanel" Margin="0,10,0,0">
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Crossfade" Content="Обычный" Tag="-1" Checked="Crossfade_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Crossfade" Content="Без паузы" Tag="0" Checked="Crossfade_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Crossfade" Content="Кроссфейд 3 с" Tag="3" Checked="Crossfade_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Crossfade" Content="6 с" Tag="6" Checked="Crossfade_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Crossfade" Content="10 с" Tag="10" Checked="Crossfade_Checked"/>
                                </WrapPanel>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,8,0,16"/>
                                <CheckBox x:Name="NormalizeToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="Normalize_Changed" Unchecked="Normalize_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Выравнивать громкость"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Тихие и громкие треки звучат одинаково. Работает для треков, громкость которых сообщает Яндекс (обычно в качестве «без потерь»)."/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- эквалайзер -->
                        <TextBlock Text="ЭКВАЛАЙЗЕР" Style="{StaticResource SettingsHeader}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="EqToggle" Style="{StaticResource ToggleSwitch}" Checked="Eq_Changed" Unchecked="Eq_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Включить эквалайзер"/>
                                        <TextBlock Style="{StaticResource SettingsHint}" Text="10 полос от 31 Гц до 16 кГц, ±12 дБ. Двойной клик по ползунку — 0 дБ."/>
                                    </StackPanel>
                                </CheckBox>
                                <WrapPanel x:Name="EqPresets" Margin="0,14,0,4"/>
                                <ItemsControl x:Name="EqBands" Margin="0,6,0,0" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- моя волна -->
                        <TextBlock Text="МОЯ ВОЛНА" Style="{StaticResource SettingsHeader}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,0,0,12"
                                           Text="Как в приложении Яндекс Музыки: что подмешивать в Мою волну. Применится при следующем запуске волны."/>
                                <TextBlock Text="По характеру" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="WaveDiversityPanel">
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveDiversity" Content="Любое" Tag="" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveDiversity" Content="Любимое" Tag="favorite" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveDiversity" Content="Незнакомое" Tag="discover" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveDiversity" Content="Популярное" Tag="popular" Checked="WaveSetting_Checked"/>
                                </WrapPanel>
                                <TextBlock Text="Под настроение" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,8"/>
                                <WrapPanel x:Name="WaveMoodPanel">
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveMood" Content="Любое" Tag="" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveMood" Content="Бодрое" Tag="active" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveMood" Content="Весёлое" Tag="fun" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveMood" Content="Спокойное" Tag="calm" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveMood" Content="Грустное" Tag="sad" Checked="WaveSetting_Checked"/>
                                </WrapPanel>
                                <TextBlock Text="По языку" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,8"/>
                                <WrapPanel x:Name="WaveLanguagePanel">
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveLanguage" Content="Любой" Tag="" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveLanguage" Content="Русский" Tag="russian" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveLanguage" Content="Иностранный" Tag="not-russian" Checked="WaveSetting_Checked"/>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="WaveLanguage" Content="Без слов" Tag="without-words" Checked="WaveSetting_Checked"/>
                                </WrapPanel>
                                <Button x:Name="WaveRestartBtn" Style="{StaticResource PillSecondary}" Content="Перезапустить волну с новыми настройками"
                                        HorizontalAlignment="Left" Padding="16,8" FontSize="13" Margin="0,8,0,0" Click="WaveRestart_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- пульт с телефона -->
                        <TextBlock Text="ПУЛЬТ С ТЕЛЕФОНА" Style="{StaticResource SettingsHeader}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="RemoteToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="RemoteToggle_Changed" Unchecked="RemoteToggle_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Управлять с телефона"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Пауза, громкость, очередь и поиск со смартфона в той же Wi-Fi сети — без приложений, прямо в браузере."/>
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock x:Name="RemoteStatus" Style="{StaticResource SettingsHint}" Margin="0,10,0,0"/>
                                <Grid x:Name="RemoteDetails" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Border Background="White" CornerRadius="12" Padding="8">
                                            <Image x:Name="RemoteQr" Width="140" Height="140" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <TextBlock Text="Твой пульт" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <Border Background="White" CornerRadius="12" Padding="8">
                                            <Image x:Name="RemoteGuestQr" Width="140" Height="140" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <TextBlock Text="Для гостей" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="22,4,0,0">
                                        <TextBlock x:Name="RemoteUrlText" FontSize="13" FontFamily="Consolas" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource SettingsHint}" Margin="0,8,0,0"
                                                   Text="Гости только ищут и предлагают треки — ты одобряешь их на компьютере. Гостевой QR показывается и в режиме вечеринки."/>
                                        <Button Style="{StaticResource PillSecondary}" Content="Сменить ссылки" HorizontalAlignment="Left"
                                                Margin="0,12,0,0" Click="RemoteReset_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- приложение -->
                        <TextBlock Text="ПРИЛОЖЕНИЕ" Style="{StaticResource SettingsHeader}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="LiveBgToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="LiveBg_Changed" Unchecked="LiveBg_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Живой фон"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Цвета обложки медленно плывут и переливаются за экраном «Сейчас играет». Выключи, если компьютер слабый."/>
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16"/>
                                <CheckBox x:Name="CloseToTrayToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Крестик сворачивает в трей"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Музыка продолжит играть. Если выключить, крестик закроет Undertone совсем."/>
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16"/>
                                <CheckBox x:Name="AutostartToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="Autostart_Changed" Unchecked="Autostart_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Запускать вместе с Windows"/>
                                        <TextBlock x:Name="AutostartHint" Style="{StaticResource SettingsHint}"
                                                   Text="Undertone тихо стартует в трее и ждёт, когда вы включите музыку."/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- интеграции -->
                        <TextBlock Text="ИНТЕГРАЦИИ" Style="{StaticResource SettingsHeader}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="ReportPlaysToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="ReportPlays_Changed" Unchecked="ReportPlays_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Отправлять прослушивания в Яндекс"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Рекомендации и «Моя волна» будут учитывать музыку, которую вы слушаете в Undertone."/>
                                    </StackPanel>
                                </CheckBox>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16"/>
                                <CheckBox x:Name="HotkeysToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="Hotkeys_Changed" Unchecked="Hotkeys_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Глобальные сочетания клавиш"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Работают, даже когда Undertone свёрнут. Нажмите на сочетание, чтобы поменять: Esc — отмена, Backspace — отключить."/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel x:Name="HotkeyRows" Margin="0,10,0,0"/>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16"/>
                                <CheckBox x:Name="DiscordToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="Discord_Changed" Unchecked="Discord_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Статус в Discord"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="«Слушает …» в профиле. Нужен Application ID: создайте приложение «Undertone» на discord.com/developers/applications и вставьте его ID ниже."/>
                                    </StackPanel>
                                </CheckBox>
                                <TextBox x:Name="DiscordAppIdBox" Style="{StaticResource PlainBox}" Tag="Application ID, например 1234567890123456789"
                                         Margin="0,10,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                         LostFocus="DiscordAppId_LostFocus" KeyDown="DiscordAppId_KeyDown"/>
                            </StackPanel>
                        </Border>

                        <!-- друзья -->
                        <TextBlock x:Name="FriendsSettingsHeader" Text="ДРУЗЬЯ" Style="{StaticResource SettingsHeader}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox x:Name="FriendsToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="FriendsToggle_Changed" Unchecked="FriendsToggle_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Показывать друзьям, что я слушаю"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Все, у кого одинаковый код компании, видят друг друга на странице «Друзья». Сообщения зашифрованы этим кодом и идут через публичные серверы MQTT — своего сервера не нужно."/>
                                    </StackPanel>
                                </CheckBox>

                                <TextBlock Text="Как тебя зовут для друзей" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,16,0,6"/>
                                <TextBox x:Name="FriendsNameBox" Style="{StaticResource PlainBox}" Tag="Имя из Яндекса" Width="300"
                                         HorizontalAlignment="Left" MaxLength="40" LostFocus="FriendsName_LostFocus" KeyDown="FriendsName_KeyDown"/>

                                <TextBlock Text="Код компании" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,16,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="14,9" Margin="0,0,8,0">
                                        <TextBlock x:Name="FriendsCodeText" Text="—" FontFamily="Cascadia Mono, Consolas" FontSize="15"/>
                                    </Border>
                                    <Button Style="{StaticResource PillSecondary}" Content="Скопировать" Padding="14,7" FontSize="12.5"
                                            Margin="0,0,8,0" Click="FriendsCopy_Click"/>
                                    <Button Style="{StaticResource PillSecondary}" Content="Создать новый" Padding="14,7" FontSize="12.5"
                                            Click="FriendsNewCode_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource SettingsHint}" Margin="0,6,0,0"
                                           Text="Отправь код друзьям. Новый код — новая компания: старые друзья перестанут тебя видеть, пока не введут его."/>

                                <TextBlock Text="Есть код от друга?" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,16,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="FriendsJoinBox" Style="{StaticResource PlainBox}" Tag="XXXX-XXXX-XXXX-XXXX-XXXX" Width="300"
                                             KeyDown="FriendsJoin_KeyDown"/>
                                    <Button Style="{StaticResource PillButton}" Content="Вступить" Padding="16,8" FontSize="13"
                                            Margin="8,0,0,0" Click="FriendsJoin_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- диагностика -->
                        <TextBlock Text="ДИАГНОСТИКА" Style="{StaticResource SettingsHeader}"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Журнал ошибок"/>
                                        <TextBlock Style="{StaticResource SettingsHint}"
                                                   Text="Если что-то сломалось, приложите файл за нужный день, когда пишете о проблеме. Токенов в журнале нет."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PillSecondary}" Content="Открыть папку логов"
                                            Padding="16,8" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" Click="LogsOpen_Click"/>
                                </Grid>
                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Папка данных"/>
                                        <TextBlock x:Name="DataPathText" Style="{StaticResource SettingsHint}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PillSecondary}" Content="Открыть"
                                            Padding="16,8" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" Click="DataOpen_Click"/>
                                </Grid>
                                <TextBlock x:Name="SettingsVersionText" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                           Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ═══════════ Плеер-бар ═══════════ -->
        <Border Grid.Row="1" Height="94" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="250"/>
                    <ColumnDefinition Width="4*" MinWidth="360"/>
                    <ColumnDefinition Width="3*" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- трек -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="58" Height="58" Cursor="Hand" MouseLeftButtonUp="BarCover_Click" ToolTip="Сейчас играет">
                        <Border CornerRadius="9" Background="{StaticResource CardBrush}">
                            <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="9">
                            <Border.Background>
                                <ImageBrush x:Name="BarCoverBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BarTitle" Text="Ничего не играет" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BarArtist" Text="Включите Мою волну" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <ItemsControl x:Name="BarArtists" ItemTemplate="{StaticResource ArtistLinkTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanel}" ClipToBounds="True" Focusable="False"
                                      FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="BarLike" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xEB51;"
                            Click="Like_Click" ToolTip="Мне нравится (L)" IsEnabled="False"/>
                </Grid>

                <!-- управление -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ShuffleBtn" Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="15"
                                Click="Shuffle_Click" ToolTip="Перемешать (S)" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="16" Foreground="{StaticResource TextBrush}"
                                Click="Prev_Click" ToolTip="Предыдущий (P)" Margin="0,0,10,0"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource PlayButton}" Content="&#xE768;"
                                Click="Play_Click" ToolTip="Играть / пауза (Пробел)"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="16" Foreground="{StaticResource TextBrush}"
                                Click="Next_Click" ToolTip="Следующий (N)" Margin="10,0,0,0"/>
                        <Button x:Name="RepeatBtn" Style="{StaticResource IconButton}" Content="&#xE8EE;" FontSize="15"
                                Click="Repeat_Click" ToolTip="Повтор (R)" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosText" Text="0:00" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Grid Grid.Column="1">
                            <!-- сколько трека уже скачано (потоковое воспроизведение) -->
                            <Border x:Name="BufferBar" Height="4" CornerRadius="2" Background="#2EFFFFFF" Width="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                            <Slider x:Name="ProgressSlider" Style="{StaticResource ThinSlider}"
                                    Minimum="0" Maximum="1" Value="0" ValueChanged="Progress_ValueChanged"/>
                        </Grid>
                        <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- мини-визуализатор + громкость -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Visualizer x:Name="MiniViz" Width="112" Height="30" BarCount="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE740;" FontSize="14" Click="Party_Click"
                            ToolTip="Режим вечеринки — на весь экран (F11)" Margin="0,0,4,0"/>
                    <Button x:Name="SleepBtn" Style="{StaticResource IconButton}" Content="&#xE708;" FontSize="14" Click="Sleep_Click"
                            ToolTip="Таймер сна" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" FontSize="14" Click="MiniPlayer_Click"
                            ToolTip="Мини-плеер поверх всех окон" Margin="0,0,4,0"/>
                    <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Content="&#xE995;" FontSize="15"
                            Click="Mute_Click" ToolTip="Без звука (M)"/>
                    <Slider x:Name="VolumeSlider" Width="110" Style="{StaticResource ThinSlider}" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" Value="0.7" Margin="4,0,0,0" ValueChanged="Volume_ValueChanged"/>
                    <!-- куда идёт звук: имя устройства, клик — выбрать другое -->
                    <Button x:Name="DeviceBtn" Margin="12,0,4,0" Click="Device_Click" Cursor="Hand" Focusable="False"
                            VerticalAlignment="Center" ToolTip="Устройство вывода">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Height="30" CornerRadius="15" Background="#0DFFFFFF" Padding="10,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DeviceGlyph" Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource LiveAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="DeviceName" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="12" Foreground="{StaticResource TextDimBrush}" MaxWidth="140"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="7,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                        <Setter TargetName="DeviceName" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="headphones">
                                        <Setter TargetName="DeviceGlyph" Property="Text" Value="&#xE7F6;"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Тост ═══════════ -->
        <Border x:Name="Toast" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="256,0,0,22"
                Background="#F2232838" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="100" Padding="20,11"
                Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <TextBlock x:Name="ToastText" FontSize="13.5" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center"/>
        </Border>

        <!-- ═══════════ Предложение гостя (пульт с телефона) ═══════════ -->
        <Border x:Name="GuestCard" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,22"
                Width="380" Background="#F2151619" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="16" Padding="12"
                Visibility="Collapsed" Panel.ZIndex="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="9" Background="{StaticResource CardBrush}">
                    <Border CornerRadius="9">
                        <Border.Background><ImageBrush x:Name="GuestCardCover" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="ГОСТЬ ПРЕДЛАГАЕТ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource LiveAccent}"/>
                    <TextBlock x:Name="GuestCardTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock x:Name="GuestCardSub" FontSize="12" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PillButton}" Content="В очередь" Padding="14,6" FontSize="12.5" Margin="0,0,8,0"
                                Click="GuestAccept_Click"/>
                        <Button Style="{StaticResource PillSecondary}" Content="Нет" Padding="14,6" FontSize="12.5" Click="GuestDecline_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Быстрый поиск (Ctrl+K) ═══════════ -->
        <Grid x:Name="QuickOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="50">
            <Border Background="#A6050608" MouseLeftButtonDown="QuickOverlay_Backdrop"/>
            <Border x:Name="QuickPanel" Width="640" VerticalAlignment="Top" Margin="0,84,0,0" CornerRadius="18"
                    Background="#F0151619" BorderBrush="#1FFFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <ScaleTransform/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="18" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="62" Margin="20,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                   Foreground="{DynamicResource LiveAccent}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="QuickPlaceholder" Text="Трек, артист, альбом…" FontSize="18"
                                       Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="QuickBox" FontSize="18" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}" CaretBrush="{DynamicResource LiveAccent}"
                                     SelectionBrush="{DynamicResource LiveAccent}" VerticalAlignment="Center"
                                     TextChanged="QuickBox_TextChanged" PreviewKeyDown="QuickBox_PreviewKeyDown">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>
                        <Control x:Name="QuickSpinner" Grid.Column="2" Style="{StaticResource Spinner}" Width="18" Height="18"
                                 Margin="0,0,10,0" Visibility="Collapsed"/>
                        <Border Grid.Column="2" x:Name="QuickEsc" Background="#14FFFFFF" CornerRadius="6" Padding="7,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                        </Border>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="#14FFFFFF"/>

                    <!-- подсказка внизу -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="20,9">
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                   Text="↑ ↓  выбрать      Enter  включить      Ctrl+Enter  сыграть следующим      Esc  закрыть"/>
                    </Border>

                    <Grid MaxHeight="460">
                        <ListBox x:Name="QuickList" Style="{StaticResource TrackList}" Margin="8,8,8,8"
                                 ScrollViewer.CanContentScroll="False" Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="QuickItem_Click"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Section}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextFaintBrush}" Margin="12,10,0,6"
                                                               Visibility="{Binding HasSection, Converter={StaticResource BoolToVis}}"/>
                                                    <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="8,6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LiveAccentSoft}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:QuickItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="40" Margin="0,0,14,0">
                                            <Border x:Name="Back" CornerRadius="8" Background="{StaticResource CardBrush}">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                           Foreground="#50FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="Img" CornerRadius="8">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Cover, Converter={StaticResource CoverConverter}, ConverterParameter=80}"
                                                                Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="T" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="Enter" Grid.Column="2" Text="&#xE751;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,6,0"
                                                   Visibility="Hidden"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRound}" Value="True">
                                            <Setter TargetName="Back" Property="CornerRadius" Value="20"/>
                                            <Setter TargetName="Img" Property="CornerRadius" Value="20"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAll}" Value="True">
                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource LiveAccent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Enter" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="QuickHint" HorizontalAlignment="Center" Margin="0,26,0,30" FontSize="13"
                                   Foreground="{StaticResource TextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Редактор подборки ═══════════ -->
        <Grid x:Name="SmartEditor" Grid.RowSpan="2" Background="#B3000000" Visibility="Collapsed" Panel.ZIndex="40">
            <Border Width="560" Background="#17181D" CornerRadius="18" Padding="28,24" BorderBrush="#26282E" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="760">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,22,0,0">
                        <Button x:Name="SmartDeleteBtn" Style="{StaticResource PillSecondary}" Content="Удалить" Click="SmartDelete_Click"
                                HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PillSecondary}" Content="Отмена" Margin="0,0,10,0" Click="SmartCancel_Click"/>
                            <Button Style="{StaticResource PillButton}" Content="Сохранить" Click="SmartSave_Click"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="Подборка" FontSize="20" FontWeight="SemiBold"/>
                        <TextBox x:Name="SmartName" Style="{StaticResource PlainBox}" Margin="0,14,0,0" Tag="Название"/>
                        <TextBlock Text="ОТКУДА БРАТЬ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="SmartSourcePills"/>
                        <TextBlock Text="НЕ ИГРАЛИ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="SmartNotPlayedPills"/>
                        <TextBlock Text="ИГРАЛИ ЗА ПОСЛЕДНИЕ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="SmartWithinPills"/>
                        <TextBlock Text="СКОЛЬКО РАЗ ИГРАЛИ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="SmartPlaysPills"/>
                        <TextBlock Text="КОГДА ЧАЩЕ СЛУШАЮ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="SmartPartPills"/>
                        <TextBlock Text="АРТИСТ (НЕОБЯЗАТЕЛЬНО)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,14,0,6"/>
                        <TextBox x:Name="SmartArtist" Style="{StaticResource PlainBox}" Tag="Часть имени, например «kizaru»"
                                 TextChanged="SmartArtist_TextChanged"/>
                        <TextBlock Text="ПОРЯДОК" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="SmartSortPills"/>
                        <TextBlock Text="СКОЛЬКО ТРЕКОВ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="SmartLimitPills"/>
                        <TextBlock x:Name="SmartPreview" FontSize="12.5" Foreground="{DynamicResource LiveAccent}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Диалог (создать / переименовать / подтвердить) ═══════════ -->
        <!-- ═══════════ Обновление: по центру, фон затемнён, ставится само ═══════════ -->
        <Grid x:Name="UpdateOverlay" Grid.RowSpan="2" Background="#B3000000" Visibility="Collapsed">
            <Border Width="440" Background="#17181D" CornerRadius="18" Padding="28,24" BorderBrush="#26282E" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource LiveAccent}"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Вышло обновление" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdOverlayVersion" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0"/>
                    <ScrollViewer MaxHeight="240" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="UpdOverlayNotes" FontSize="13.5" TextWrapping="Wrap" LineHeight="20"/>
                    </ScrollViewer>
                    <Grid x:Name="UpdOverlayTrack" Height="6" Margin="0,20,0,0">
                        <Border CornerRadius="3" Background="#26282E"/>
                        <Border x:Name="UpdOverlayBar" CornerRadius="3" RenderTransformOrigin="0,0.5"
                                Background="{DynamicResource LiveAccent}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="UpdOverlayBarScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="UpdOverlayStatus" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,90,0"/>
                        <Button x:Name="UpdOverlayHide" Style="{StaticResource PillSecondary}" Content="Скрыть"
                                HorizontalAlignment="Right" Click="UpdOverlayHide_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DialogOverlay" Grid.RowSpan="2" Background="#B3000000" Visibility="Collapsed">
            <Border Width="420" Background="#17181D" CornerRadius="18" Padding="28,24" BorderBrush="#26282E" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="DialogMessage" FontSize="13.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <TextBox x:Name="DialogInput" Style="{StaticResource PlainBox}" Margin="0,16,0,0" Tag="Название"
                             KeyDown="DialogInput_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource PillSecondary}" Content="Отмена" Margin="0,0,10,0" Click="DialogCancel_Click"/>
                        <Button x:Name="DialogOk" Style="{StaticResource PillButton}" Content="OK" Click="DialogOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Вход ═══════════ -->
        <Grid x:Name="AuthOverlay" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.Resources>
                <!-- большая кнопка выбора сервиса -->
                <Style x:Key="ServiceCard" TargetType="Button">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource BgBrush}" CornerRadius="14" Padding="16,14"
                                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#44FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="RenderTransform">
                                            <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- «← Другой сервис» -->
                <Style x:Key="BackLink" TargetType="Button">
                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="0,4">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#1E2230" Offset="0"/>
                    <GradientStop Color="#0E1016" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Border Width="480" Background="{StaticResource CardBrush}" CornerRadius="22" Padding="38,34"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <!-- закрыть, если подключаем второй аккаунт поверх работающего -->
                    <Button x:Name="AuthCancel" Style="{StaticResource IconButton}" Content="&#xE711;" Width="32" Height="32"
                            FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-20,0"
                            ToolTip="Отмена (Esc)" Click="AuthCancel_Click" Visibility="Collapsed"/>

                    <StackPanel>
                        <Image Source="/Assets/logo-mark.png" Height="58" HorizontalAlignment="Left" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- ─── шаг 1: выбор сервиса ─── -->
                        <StackPanel x:Name="AuthChoosePanel">
                            <TextBlock Text="Вход в Undertone" FontSize="26" FontWeight="Bold" Margin="0,20,0,0"/>
                            <TextBlock x:Name="AuthChooseHint" Text="Выберите, откуда слушать музыку."
                                       Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,8,0,20"/>

                            <Button Style="{StaticResource ServiceCard}" Click="AuthChooseYandex_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="44" Height="44">
                                        <Ellipse Fill="#FFCC00"/>
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#14161C"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Яндекс Музыка" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="YandexConnected" Text="  · вход выполнен" FontSize="12.5"
                                                       Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <TextBlock Text="Моя волна, лайки, плейлисты · вход по коду" FontSize="12.5"
                                                   Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource ServiceCard}" Click="AuthChooseSc_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="44" Height="44">
                                        <Ellipse Fill="#FF5500"/>
                                        <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="SoundCloud" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ScConnected" Text="  · вход выполнен" FontSize="12.5"
                                                       Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <TextBlock Text="Лайки, плейлисты, поиск · вход через браузер" FontSize="12.5"
                                                   Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- ─── Яндекс: вход по коду ─── -->
                        <StackPanel x:Name="AuthYandexPanel" Visibility="Collapsed">
                            <TextBlock Text="Вход в Яндекс Музыку" FontSize="26" FontWeight="Bold" Margin="0,20,0,0"/>
                            <TextBlock x:Name="AuthHint" Text="Откройте страницу на любом устройстве и введите код:"
                                       Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Border Background="{StaticResource BgBrush}" CornerRadius="14" Padding="16,18" Margin="0,18,0,0">
                                <TextBlock x:Name="AuthCode" Text="· · · · · ·" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="AuthOpen" Style="{StaticResource PillButton}" Click="AuthOpen_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="AuthOpenText" Text="Открыть ya.ru/device" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PillSecondary}" Click="AuthCopy_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Скопировать код" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Control Style="{StaticResource Spinner}" Width="16" Height="16"/>
                                <TextBlock x:Name="AuthStatus" Text="Получаю код…" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,24,0,16"/>

                            <TextBlock Text="Уже есть access_token? Вставьте его:" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AuthManual" Style="{StaticResource PlainBox}" Tag="y0_…" KeyDown="AuthManual_KeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource PillSecondary}" Content="Сохранить" Padding="16,8"
                                        Margin="8,0,0,0" Click="AuthManual_Click"/>
                            </Grid>
                            <TextBlock x:Name="AuthEnvPath" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                            <Button Style="{StaticResource BackLink}" Content="← Другой сервис" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Click="AuthBack_Click"/>
                        </StackPanel>

                        <!-- ─── SoundCloud: вход через браузер ─── -->
                        <StackPanel x:Name="AuthScPanel" Visibility="Collapsed">
                            <TextBlock Text="Вход в SoundCloud" FontSize="26" FontWeight="Bold" Margin="0,20,0,0"/>
                            <TextBlock x:Name="ScHint" Text="Откроется браузер — войдите в SoundCloud и разрешите доступ Undertone."
                                       Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button x:Name="ScOpen" Style="{StaticResource PillButton}" Click="ScOpen_Click" Margin="0,0,10,0"
                                        IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Открыть браузер снова" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ScRetry" Style="{StaticResource PillSecondary}" Click="ScRetry_Click" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Повторить" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Control x:Name="ScSpinner" Style="{StaticResource Spinner}" Width="16" Height="16" VerticalAlignment="Top"
                                         Margin="0,2,0,0"/>
                                <TextBlock x:Name="ScStatus" Text="Открываю браузер…" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="370"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,24,0,14"/>
                            <TextBlock Text="Полностью играются треки, которые автор открыл для всех. Треки по подписке Go+ — только 30-секундный фрагмент."
                                       FontSize="12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ScEnvPath" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Button Style="{StaticResource BackLink}" Content="← Другой сервис" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Click="AuthBack_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
