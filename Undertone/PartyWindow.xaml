<Window x:Class="Undertone.PartyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Undertone.UI"
        Title="Undertone — вечеринка" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#08090B" Foreground="{StaticResource TextBrush}" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        KeyDown="Window_KeyDown" MouseDoubleClick="Window_MouseDoubleClick" MouseMove="Window_MouseMove">
    <Grid>
        <!-- фон: размытая обложка + живые пятна + затемнение -->
        <Grid ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.35" Margin="-160">
                <Image.Effect>
                    <BlurEffect Radius="140" KernelType="Gaussian" RenderingBias="Performance"/>
                </Image.Effect>
            </Image>
            <ui:LiveBackdrop x:Name="Live" Opacity="0.8"/>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#3008090B" Offset="0"/>
                        <GradientStop Color="#C008090B" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Viewbox Stretch="Uniform" Margin="60,50">
            <!-- рисуем под 1600×900 и масштабируем под любой экран, хоть телевизор -->
            <Grid Width="1600" Height="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- обложка -->
                <Grid Width="560" Height="560" VerticalAlignment="Center">
                    <Border CornerRadius="28" Background="#01000000" Margin="30,50,30,0">
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" Color="#BFC3D0" BlurRadius="160" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="28" Background="#18191E">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="60" ShadowDepth="18" Opacity="0.55" Color="Black"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="28">
                        <Border.Background>
                            <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="28" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                    <Canvas x:Name="ReactionLayer" IsHitTestVisible="False"/>
                </Grid>

                <!-- трек и текст -->
                <DockPanel Grid.Column="1" Margin="80,0,0,0" VerticalAlignment="Center" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="SourceText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource LiveAccent}"
                                   Text="СЕЙЧАС ИГРАЕТ"/>
                        <TextBlock x:Name="TitleText" FontSize="76" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="190" LineHeight="90" LineStackingStrategy="BlockLineHeight" Margin="0,12,0,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock x:Name="ArtistText" FontSize="34" Opacity="0.8" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <!-- прогресс -->
                        <Grid Height="6" Margin="0,40,0,0" MaxWidth="820" HorizontalAlignment="Left" Width="820">
                            <Border CornerRadius="3" Background="#22FFFFFF"/>
                            <Border x:Name="ProgressFill" CornerRadius="3" Background="{DynamicResource LiveAccent}"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <Grid Width="820" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <TextBlock x:Name="PosText" FontSize="18" Foreground="{StaticResource TextDimBrush}" Text="0:00"/>
                            <TextBlock x:Name="DurText" FontSize="18" Foreground="{StaticResource TextDimBrush}" Text="0:00"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- караоке: прошлая строка, текущая (крупно), две следующие -->
                    <StackPanel x:Name="Karaoke" Margin="0,46,0,0" VerticalAlignment="Top">
                        <TextBlock x:Name="LinePrev" FontSize="30" Foreground="#55FFFFFF" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LineNow" FontSize="52" TextWrapping="Wrap" FontWeight="Bold" Margin="0,14,0,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="White"/>
                        <TextBlock x:Name="LineNowTr" FontSize="26" TextWrapping="Wrap" Foreground="{DynamicResource LiveAccent}"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="LineNext" FontSize="30" Foreground="#80FFFFFF" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBlock x:Name="LineNext2" FontSize="30" Foreground="#40FFFFFF" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- низ: комната слева, QR справа -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="RoomText" FontSize="20" Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock x:Name="HintText" FontSize="15" Foreground="#50FFFFFF" Margin="0,8,0,0"
                                   Text="Esc — выйти · двойной клик — выйти · Win+Shift+→ — на другой экран"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="Что за трек?" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="Наведи камеру телефона" FontSize="16" Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Background="White" CornerRadius="16" Padding="10">
                            <Image x:Name="QrImage" Width="132" Height="132" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
