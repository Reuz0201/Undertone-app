<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041 — нужен для SMTC (оверлей Windows, кнопки наушников, экран блокировки) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Undertone</RootNamespace>
    <AssemblyName>Undertone</AssemblyName>
    <Product>Undertone</Product>
    <Version>3.7.0</Version>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\undertone.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- звук: декодирование (Media Foundation), вывод (WASAPI / WaveOut) — нужен для визуализации -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\undertone.ico" />
    <Resource Include="Assets\logo-mark.png" />
    <Resource Include="Assets\Reactions\*.png" />
  </ItemGroup>

  <!-- CI передаёт -p:UpdateRepo=owner/repo — откуда приложение будет брать обновления -->
  <ItemGroup Condition="'$(UpdateRepo)' != ''">
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <!-- и -p:UpdatePublicKey=<base64> — публичный ключ подписи обновлений (см. RELEASING.md) -->
  <ItemGroup Condition="'$(UpdatePublicKey)' != ''">
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(UpdatePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <!-- тесты видят internal-методы (разбор ответов API, очередь, обновлятор) -->
    <InternalsVisibleTo Include="Undertone.Tests" />
  </ItemGroup>

</Project>
