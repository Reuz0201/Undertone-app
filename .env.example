# Обычно этот файл не нужен: просто запусти Undertone — он предложит войти по коду
# и сам сохранит токены в %LOCALAPPDATA%\Undertone\.env в зашифрованном виде (DPAPI).
#
# Если токен уже есть, его можно положить в .env рядом со start.bat — при первом запуске
# Undertone перенесёт его в свою папку и зашифрует.
access_token: <токен>
refresh_token: <refresh-токен>
