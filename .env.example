# Обычно этот файл не нужен: просто запусти Undertone — он предложит войти по коду
# и сам сохранит токены в %LOCALAPPDATA%\Undertone\.env в зашифрованном виде (DPAPI).
#
# Если токен уже есть, его можно положить в .env рядом со start.bat — при первом запуске
# Undertone перенесёт его в свою папку и зашифрует.
access_token: <токен>
refresh_token: <refresh-токен>

# ── SoundCloud ──
# Ключ приложения: зарегистрируй его на https://soundcloud.com/you/apps
# и укажи там Redirect URI: http://127.0.0.1:47823/callback
# Впиши сюда (в %LOCALAPPDATA%\Undertone\.env или в .env рядом со start.bat):
soundcloud_client_id: <client_id>
soundcloud_client_secret: <client_secret>
# необязательно — если порт 47823 занят (тот же адрес впиши в настройках приложения SoundCloud):
# soundcloud_redirect_uri: http://127.0.0.1:47823/callback
# Токены SoundCloud приложение запишет само (soundcloud_access_token…, зашифрованы DPAPI).

# ── Spotify (нужен Premium) ──
# Создай приложение на https://developer.spotify.com/dashboard:
#   Redirect URI: http://127.0.0.1:47824/callback   (именно 127.0.0.1, не localhost)
#   APIs: Web API и Web Playback SDK
#   User Management: добавь свой e-mail Spotify (в режиме разработки пускает только добавленных, до 5 человек)
# Секрет не нужен — вход по PKCE. Проще всего вставить Client ID на экране входа — он сам сохранится сюда.
# Или впиши руками:
spotify_client_id: <client_id>
# необязательно — если порт 47824 занят (тот же адрес впиши в Dashboard):
# spotify_redirect_uri: http://127.0.0.1:47824/callback
